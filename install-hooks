#!/usr/bin/env bash
# install-hooks — install this repo's git hooks (lefthook).
#
# Standalone + idempotent. Safe to run on its own at any time:
#     ./install-hooks
# Also invoked by ./bootstrap (full mode) so a fresh clone gets hooks wired up.
#
# This ONLY affects committing/pushing FROM this repo (e.g. the mise.lock guard
# in lefthook.yml). It installs nothing a normal `sync` needs, so it is kept
# separate from the package-install flow on purpose.
#
# No-ops cleanly when:
#   - not inside a git work tree (e.g. a tarball download), or
#   - lefthook isn't available yet (e.g. before `sync` installs it).

set -euo pipefail

ENV_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ENV_DIR"

have() { command -v "$1" >/dev/null 2>&1; }

# Must be a git repo for hooks to mean anything.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "→ install-hooks: not a git work tree; skipping"
  exit 0
fi

# lefthook is a workstation tool (installed by sync via mise). It may not be on
# PATH yet on a brand-new box. Try PATH, then the mise shim, before giving up.
LEFTHOOK=""
if have lefthook; then
  LEFTHOOK="lefthook"
elif have mise && mise which lefthook >/dev/null 2>&1; then
  LEFTHOOK="mise exec lefthook --"
fi

if [[ -z "$LEFTHOOK" ]]; then
  echo "→ install-hooks: lefthook not available yet; skipping."
  echo "  (it installs via sync; re-run ./install-hooks afterward to wire hooks.)"
  exit 0
fi

if [[ ! -f "$ENV_DIR/lefthook.yml" ]]; then
  echo "→ install-hooks: no lefthook.yml found; skipping"
  exit 0
fi

echo "→ installing git hooks (lefthook)"
$LEFTHOOK install 2>&1 | sed 's/^/    /'
