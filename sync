#!/usr/bin/env bash
# sync — idempotent re-runner.
#
# Reads ~/.config/environment/profile-* markers, regenerates out/,
# re-symlinks home/, runs brew bundle (mac) and mise install per
# active profile.

set -euo pipefail

ENV_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ENV_DIR"

MARKER_DIR="$HOME/.config/environment"

# ───────── detect OS ─────────
case "$(uname -s)" in
  Darwin) OS=mac ;;
  Linux)  OS=linux ;;
  *) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

# ───────── resolve active profiles ─────────
# base is always active. requires chain:
#   workstation → base
#   work        → workstation
#   personal    → workstation
ACTIVE=("base")
[[ -f "$MARKER_DIR/profile-workstation" ]] && ACTIVE+=("workstation")
[[ -f "$MARKER_DIR/profile-work" ]]        && ACTIVE+=("workstation" "work")
[[ -f "$MARKER_DIR/profile-personal" ]]    && ACTIVE+=("workstation" "personal")
[[ -f "$MARKER_DIR/profile-server" ]]      && ACTIVE+=("server")

# Dedupe
PROFILES=$(printf '%s\n' "${ACTIVE[@]}" | sort -u | paste -sd, -)

echo "═══ sync ═══"
echo "host:     $(hostname)"
echo "os:       $OS"
echo "profiles: $PROFILES"
echo

have() { command -v "$1" >/dev/null 2>&1; }

# ───────── 1. regenerate out/ ─────────
if have uv && [[ -f "$ENV_DIR/generate.py" ]]; then
  echo "→ regenerating out/"
  ./generate.py --target "$OS" --profiles "$PROFILES" 2>&1 | sed 's/^/    /' || {
    echo "  ! generate.py failed; continuing with existing out/" >&2
  }
elif [[ -d "$ENV_DIR/out" ]]; then
  echo "→ uv not found; using committed out/ as-is"
else
  echo "  ! uv not available AND no committed out/. Cannot install packages." >&2
  echo "  (symlinks will still run)" >&2
fi

# ───────── 2. re-symlink home/ into $HOME ─────────
# Same backup behavior as bootstrap: any real (non-symlink) file in $HOME
# that we'd clobber is moved to ~/.environment-backup-<timestamp>/ first.
if [[ -d "$ENV_DIR/home" ]]; then
  echo "→ re-symlinking home/"
  backup_dir="$HOME/.environment-backup-$(date +%Y%m%d-%H%M%S)"
  backup_used=0
  while IFS= read -r -d '' src; do
    rel="${src#$ENV_DIR/home/}"
    dst="$HOME/$rel"
    mkdir -p "$(dirname "$dst")"
    if [[ -e "$dst" ]] && [[ ! -L "$dst" ]]; then
      [[ $backup_used -eq 0 ]] && { mkdir -p "$backup_dir"; backup_used=1; }
      mkdir -p "$(dirname "$backup_dir/$rel")"
      mv "$dst" "$backup_dir/$rel"
    fi
    ln -sfn "$src" "$dst"
  done < <(find "$ENV_DIR/home" -type f -print0)
  if [[ $backup_used -eq 1 ]]; then
    echo "  (real files backed up in $backup_dir)"
  fi
fi

# ───────── 3. mise install (cross-OS) ─────────
if have mise; then
  # Build a single ~/.config/mise/config.toml from the active profiles.
  # Each per-profile file has its own [tools] / [settings] headers — TOML
  # doesn't allow duplicate sections, so we strip the headers from all but
  # the first occurrence and concatenate just the entries.
  mkdir -p "$HOME/.config/mise"
  cfg="$HOME/.config/mise/config.toml"
  {
    echo "# Generated by ~/environment/sync — do not edit by hand."
    echo "# Concatenation of per-profile mise configs for active profiles: $PROFILES"
    echo ""
    echo "[tools]"
    IFS=, read -ra PROF_LIST <<< "$PROFILES"
    for p in "${PROF_LIST[@]}"; do
      f="$ENV_DIR/out/mise.config.$p.toml"
      [[ -f "$f" ]] || continue
      # Pull entries between [tools] and the next [section], skip blanks/comments
      awk '/^\[tools\]/{flag=1;next} /^\[/{flag=0} flag && /^[a-zA-Z]/' "$f"
    done
    echo ""
    echo "[settings]"
    echo "experimental = true"
    echo "auto_install = true"
    echo "lockfile = true"
    echo 'minimum_release_age = "7d"   # supply-chain mitigation: refuse versions released <7 days ago'
  } > "$cfg"
  if [[ -s "$cfg" ]]; then
    echo "→ mise install"
    mise install 2>&1 | sed 's/^/    /' || echo "  ! mise install had errors" >&2
  fi
else
  echo "  · mise not installed; skipping mise install"
fi

# ───────── 4. brew bundle (mac only) ─────────
# sync is the FAST, idempotent path: never auto-updates Homebrew's metadata and
# never upgrades already-installed packages — it only installs what's MISSING.
# Run `./upgrade` for the slow `brew update && brew upgrade` path.
if [[ "$OS" == "mac" ]] && have brew; then
  export HOMEBREW_NO_AUTO_UPDATE=1      # skip the slow git-fetch of all taps
  export HOMEBREW_NO_INSTALL_UPGRADE=1  # don't upgrade deps as a side effect
  export HOMEBREW_BUNDLE_NO_LOCK=1      # don't write Brewfile.lock.json
  IFS=, read -ra PROF_LIST <<< "$PROFILES"
  for p in "${PROF_LIST[@]}"; do
    bf="$ENV_DIR/out/Brewfile.$p"
    if [[ -f "$bf" ]] && [[ -s "$bf" ]]; then
      # Skip if file has only comments/whitespace
      if grep -qE '^(brew|cask|tap)' "$bf"; then
        # check is fast and read-only: if everything's already present, skip the
        # install entirely (no re-adopt/chmod attempts on IT-managed apps).
        if brew bundle check --file="$bf" >/dev/null 2>&1; then
          echo "→ brew bundle ($(basename "$bf")): already satisfied, skipping"
        else
          echo "→ brew bundle install --file=$(basename "$bf") (missing only)"
          brew bundle install --no-upgrade --file="$bf" 2>&1 | sed 's/^/    /' || true
        fi
      fi
    fi
  done
fi

echo
echo "✓ sync complete"
