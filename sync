#!/usr/bin/env bash
# Converge the work Mac from the direct mise config and Brewfile.

set -euo pipefail

ENV_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ENV_DIR"

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "sync supports the work Mac only" >&2
  exit 1
fi

have() { command -v "$1" >/dev/null 2>&1; }

echo "═══ sync ═══"

echo "→ linking dotfiles"
backup_dir="$HOME/.environment-backup-$(date +%Y%m%d-%H%M%S)"
backup_used=0
while IFS= read -r -d '' src; do
  rel="${src#"$ENV_DIR"/home/}"
  dst="$HOME/$rel"
  mkdir -p "$(dirname "$dst")"
  if [[ -e "$dst" && ! -L "$dst" ]]; then
    [[ $backup_used -eq 0 ]] && { mkdir -p "$backup_dir"; backup_used=1; }
    mkdir -p "$(dirname "$backup_dir/$rel")"
    mv "$dst" "$backup_dir/$rel"
  fi
  ln -sfn "$src" "$dst"
done < <(find "$ENV_DIR/home" -type f -print0)
[[ $backup_used -eq 1 ]] && echo "  existing files backed up in $backup_dir"

echo "→ syncing zsh plugins"
plugin_dir="$HOME/.config/zsh/plugins"
mkdir -p "$plugin_dir"
[[ -d "$plugin_dir/zsh-autosuggestions/.git" ]] || \
  git clone https://github.com/zsh-users/zsh-autosuggestions "$plugin_dir/zsh-autosuggestions"
[[ -d "$plugin_dir/zsh-syntax-highlighting/.git" ]] || \
  git clone https://github.com/zsh-users/zsh-syntax-highlighting "$plugin_dir/zsh-syntax-highlighting"

if ! have mise; then
  echo "mise is required; run ./bootstrap" >&2
  exit 1
fi

echo "→ installing locked mise tools"
mise install --locked

if mise which git-lfs >/dev/null 2>&1; then
  mise exec git-lfs -- git lfs install
fi

if ! have brew; then
  echo "Homebrew is required; run ./bootstrap" >&2
  exit 1
fi

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_UPGRADE=1
export HOMEBREW_BUNDLE_NO_UPGRADE=1

if brew bundle check --no-upgrade --file="$ENV_DIR/Brewfile" >/dev/null 2>&1; then
  echo "→ Brewfile already satisfied"
else
  echo "→ installing missing Brewfile entries"
  brew bundle install --no-upgrade --file="$ENV_DIR/Brewfile"
fi

echo
echo "✓ sync complete"
