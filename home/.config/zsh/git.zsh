# git aliases (replaces oh-my-zsh's git plugin)
alias g='git'
alias gst='git status'
alias gco='git checkout'
alias gp='git pull'
alias gpu='git push'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
alias gdf='git diff --staged'
alias gs='git switch'
alias gcm='git commit -m'
# git stash --include-untracked (preserves untracked files in the stash)
alias gsu='git stash -u'
