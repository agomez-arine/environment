# Note: official archlinux:latest is x86_64-only. For ARM (e.g., this M-series Mac),
# we use menci/archlinuxarm which mirrors Arch packages on aarch64.
# On a real x86_64 box you'd FROM archlinux:latest.
FROM menci/archlinuxarm:latest

# Skip full -Syu (Docker buildkit's read-only /etc/{resolv.conf,hosts} mounts
# trip pacman's disk-space check). Just refresh DBs and install what we need
# with --overwrite='*' to dodge the gcc-libs split conflict.
RUN pacman -Sy --noconfirm
# Install our deps PLUS openssl (needed to satisfy libngtcp2_crypto_ossl
# pulled in by curl). Without an updated openssl, git's https remote helper
# fails at runtime. Skip cache-clean — same openssl issue would crash it.
RUN pacman -S --noconfirm --needed --overwrite='*' --disable-sandbox \
      openssl \
      libssh2 \
      curl \
      git \
      zsh \
      sudo \
      tmux \
      which

RUN useradd -m -s /bin/zsh tester && \
    echo "tester ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER tester
WORKDIR /home/tester

CMD ["/bin/zsh"]
