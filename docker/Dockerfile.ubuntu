FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      zsh \
      git \
      curl \
      ca-certificates \
      sudo \
      tmux \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/zsh tester && \
    echo "tester ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER tester
WORKDIR /home/tester

CMD ["/bin/zsh"]
