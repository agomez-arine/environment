#!/usr/bin/env bash
# Upgrade packages within the ranges declared by mise and Homebrew.

set -euo pipefail

ENV_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ENV_DIR"

DRY_RUN=0
[[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]] && DRY_RUN=1

if [[ $DRY_RUN -eq 1 ]]; then
  echo "→ Homebrew packages with updates"
  HOMEBREW_NO_AUTO_UPDATE=1 brew outdated || true
  echo "→ mise upgrade preview"
  mise upgrade --dry-run
  exit 0
fi

echo "→ updating Homebrew metadata"
brew update
echo "→ upgrading declared Brewfile entries"
brew bundle install --file="$ENV_DIR/Brewfile"
echo "→ upgrading mise tools and lockfile"
mise upgrade

echo
echo "✓ upgrade complete; review and commit config/lock changes"
